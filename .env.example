VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Optional: use a web callback now and a Tauri deep link later.
VITE_AUTH_REDIRECT_URL=http://localhost:5173/auth/callback
# Production build: required, and must be a real wss:// endpoint.
# VITE_SIGNALING_URL=wss://your-signaling-host
# Optional ICE configuration. VITE_ICE_SERVERS accepts a JSON array of RTCIceServer objects.
# VITE_STUN_URL=stun:your-stun-host:3478
# VITE_TURN_URL=turn:your-turn-host:3478
# VITE_TURN_USERNAME=temporary-username
# VITE_TURN_CREDENTIAL=temporary-credential
# If the signaling server uses a non-default TTL, mirror it here for client cache renewal.
# VITE_TURN_CREDENTIAL_TTL_SECONDS=86400
# Development-only diagnostic mode; production should normally use "all".
# VITE_WEBRTC_FORCE_RELAY=true
